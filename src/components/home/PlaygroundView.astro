---
import SiteLayout from "../../layouts/SiteLayout.astro";
import HomeContent from "./HomeContent.astro";
import {
  PRESET_OPTIONS,
  playgroundPathForPreset,
  type AppearanceState,
} from "../../design/presets";
import type { DesignSpec } from "../../design/types";
import { withBase } from "../../lib/base";

interface Props {
  spec: DesignSpec;
  appearance: AppearanceState;
}

const { spec, appearance } = Astro.props;
---

<SiteLayout
  spec={spec}
  appearance={appearance}
  title="Playground — Chirag R Gandhi"
  active="playground"
  drawerExpanded={false}
  showAppearance={true}
>
  <style>
    .playground-intro {
      font-size: 1rem;
      line-height: 1.65;
      color: var(--muted);
      max-width: 58ch;
      margin-bottom: 1.5rem;
    }
    .playground-intro a { color: var(--ink); }
    .playground-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      font-size: 0.875rem;
      margin-top: 0.75rem;
    }
    .playground-links a { color: var(--muted); }
  </style>

  <div class="playground-intro">
    <p>
      This site is parametric: a seed resolves to a design spec, which drives the CSS — type, color, hero, motion. Pick a theme below. The wilder 24-persona lab stays local-only.
    </p>
    <div class="playground-links">
      <a href={withBase()}>← Home</a>
      <a href={withBase("projects/this-portfolio-site")}>Case study →</a>
    </div>
  </div>

  <div class="theme-presets" role="group" aria-label="Theme presets">
    <p class="theme-presets-label">View this site in different themes:</p>
    <div class="theme-presets-row">
      {PRESET_OPTIONS.map((p) => (
        <a
          href={withBase(playgroundPathForPreset(p.id))}
          class:list={["preset-btn", appearance.preset === p.id && "active"]}
          title={p.label}
        >
          {p.shortLabel}
        </a>
      ))}
    </div>
  </div>

  <HomeContent spec={spec} />
</SiteLayout>
