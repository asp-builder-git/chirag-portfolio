---
import { projects } from "../../data/projects";
---

<style>
  /* Hero */
  .intro h1 {
    font-family: var(--font-display);
    font-size: clamp(var(--hero-size-min, 2.5rem), var(--hero-size-mid, 2rem + 3.5vw), var(--hero-size-max, 4rem));
    font-weight: var(--display-weight, 400);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .intro .role {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.2rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
    margin-top: 0.5rem;
    max-width: 46ch;
  }
  .intro .plain {
    font-size: 1.0625rem;
    line-height: var(--line-height-body, 1.65);
    color: var(--ink);
    margin-top: 1rem;
    max-width: 60ch;
  }
  .intro .status-chip {
    display: inline-flex;
    align-items: center;
    margin-top: 1.1rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }
  .intro .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }
  .intro { margin-bottom: calc(clamp(3rem, 6vw, 4.5rem) * var(--space-section, 1)); }

  .section + .section {
    margin-top: calc(clamp(3rem, 6vw, 4.5rem) * var(--space-section, 1));
  }
  .section .label { display: block; margin-bottom: 1.25rem; }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem 1.75rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.5rem;
  }
  :global([data-pillar-layout="stack"]) .pillars {
    grid-template-columns: 1fr;
  }
  .pillar .pillar-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .pillar h3 {
    font-size: 1.0625rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }
  .pillar p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.5rem;
  }
  .metric {
    flex: 1 1 150px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card, 10px);
    padding: 1rem 1.1rem;
    background: var(--surface);
    box-shadow: var(--shadow-md, none);
  }
  .metric .metric-num {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .metric .metric-label {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
    margin-top: 0.35rem;
  }

  .row {
    border-top: 1px solid var(--hairline);
    padding: 1.25rem 0;
  }
  .row .row-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.75rem;
  }
  .row .row-title a { text-decoration: none; }
  .row .row-title a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .row p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 0.3rem;
    max-width: 60ch;
  }
  .section .more { margin-top: 1.25rem; }

  @media (max-width: 640px) {
    .pillars { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<header class="intro">
  <h1>Chirag R Gandhi</h1>
  <p class="role">Internal Platform Product Manager — Workflow Orchestration &amp; Enterprise Automation</p>
  <p class="plain">I build internal platforms that turn manual work into deterministic automation — used by ~400 negotiators across 9 EU markets.</p>
  <span class="status status-chip">Luxembourg · EU · Remote-ready</span>
  <div class="cta-row">
    <a class="btn btn-primary" href="/chirag-portfolio/projects">See the work</a>
    <a class="btn btn-secondary" href="/chirag-portfolio/resume">Resume</a>
  </div>
</header>

<section class="section">
  <h2 class="label">Operating philosophy</h2>
  <div class="pillars">
    <div class="pillar">
      <span class="pillar-index">01</span>
      <h3>Internal employees are the customer</h3>
      <p>Product-market fit is measured in daily use, not downloads. The platform's ~400 negotiators decide if it lives or dies.</p>
    </div>
    <div class="pillar">
      <span class="pillar-index">02</span>
      <h3>Data over opinions</h3>
      <p>40,937 audit entries showed 82% of requests were standardized and repeatable. That evidence, not instinct, drove the argument for deterministic automation over conversational AI — now a VP-level 2026 priority.</p>
    </div>
    <div class="pillar">
      <span class="pillar-index">03</span>
      <h3>Automation that compounds</h3>
      <p>~3.6M actions a year, up 120%+ YoY, and reliability up +148 bps (94.87% → 96.35%). Every deterministic workflow removes a human-in-the-loop step and makes the next one cheaper.</p>
    </div>
  </div>
</section>

<section class="section">
  <h2 class="label">Impact</h2>
  <div class="metrics">
    <div class="metric">
      <div class="metric-num">€0.36Bn/yr</div>
      <div class="metric-label">Profitability supported by platform negotiations</div>
    </div>
    <div class="metric">
      <div class="metric-num">~3.6M</div>
      <div class="metric-label">Actions/year on the platform (+120% YoY)</div>
    </div>
    <div class="metric">
      <div class="metric-num">~400</div>
      <div class="metric-label">Negotiators across 9 EU markets</div>
    </div>
    <div class="metric">
      <div class="metric-num">+148bps</div>
      <div class="metric-label">Reliability gain (94.87% → 96.35%)</div>
    </div>
    <div class="metric">
      <div class="metric-num">8h → 1h</div>
      <div class="metric-label">Vendor prep time with GenAI accelerator</div>
    </div>
  </div>
</section>

<section class="section">
  <h2 class="label">Projects</h2>

  <div class="project-list">
  {
    projects.map((p) => (
      <div class="row">
        <div class="row-title">
          <a href={`/chirag-portfolio/projects/${p.slug}`}>{p.name}</a>
          <span class="status">{p.status}</span>
        </div>
        <p>
          {p.blurb} {p.difficulty}
        </p>
      </div>
    ))
  }
  </div>

  <a class="btn btn-secondary more" href="/chirag-portfolio/projects">All projects →</a>
</section>
