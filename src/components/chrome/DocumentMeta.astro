---
import { withBase } from "../../lib/base";

/**
 * Shared document meta + Open Graph tags (ORG-6.5).
 */
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath = "",
  noindex = false,
  ogImage,
} = Astro.props;

const siteOrigin = (Astro.site?.origin ?? "https://asp-builder-git.github.io").replace(/\/+$/, "");
const path = withBase(canonicalPath.replace(/^\//, ""));
const canonical = `${siteOrigin}${path}`;
const image = ogImage ?? `${siteOrigin}${withBase("favicon.svg")}`;
---

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="generator" content={Astro.generator} />
)}
{!noindex && <meta name="description" content={description} />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && <meta property="og:type" content="website" />}
{!noindex && <meta property="og:title" content={title} />}
{!noindex && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonical} />}
{!noindex && <meta property="og:image" content={image} />}
{!noindex && <meta name="twitter:card" content="summary" />}
{!noindex && <meta name="twitter:title" content={title} />}
{!noindex && <meta name="twitter:description" content={description} />}
