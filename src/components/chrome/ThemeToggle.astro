---
/**
 * Theme toggle control — shared chrome (ORG-5.1).
 * Behavior bound by src/scripts/theme.ts via #theme-toggle.
 */
---
<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/></svg>
</button>
