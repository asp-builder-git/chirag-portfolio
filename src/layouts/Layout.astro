---
interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about" | "projects" | "writing" | "resume";
}

const {
  title = "Chirag Gandhi — Senior Product Manager & Builder",
  active,
} = Astro.props;

const description =
  "Chirag Gandhi — Senior Product Manager in Luxembourg. 11+ years at Amazon building platforms, negotiation systems, and AI tools. €0.9Bn under management, adoption 5% to 100%.";

const links = [
  { href: "/chirag-portfolio/", label: "Home", key: "home" },
  { href: "/chirag-portfolio/about", label: "About", key: "about" },
  { href: "/chirag-portfolio/projects", label: "Projects", key: "projects" },
  { href: "/chirag-portfolio/writing", label: "Writing", key: "writing" },
  { href: "/chirag-portfolio/resume", label: "Resume", key: "resume" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --bg: #fffdf8;
        --card: #ffffff;
        --ink: #1a1a1a;
        --muted: #6f675e;
        --accent: #e8590c;
        --accent-dark: #c94d08;
        --accent-soft: #fceee3;
        --border: #e9e2d6;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
        color: var(--ink);
      }
      .container { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
      nav {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.4rem;
        padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); margin-bottom: 3.5rem;
      }
      nav a {
        color: var(--ink); text-decoration: none; font-size: 0.95rem; font-weight: 500;
        padding: 0.2rem 0; border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      nav a:hover { color: var(--accent); }
      nav a.active { color: var(--accent); border-bottom-color: var(--accent); }
      nav a.cta {
        margin-left: auto; padding: 0.4rem 0.95rem; border: 1px solid var(--accent);
        border-radius: 999px; color: var(--accent); font-weight: 600;
      }
      nav a.cta:hover { background: var(--accent); color: #fff; }
      main { min-height: 50vh; }
      footer {
        margin-top: 4rem; padding-top: 1.75rem; border-top: 1px solid var(--border);
        color: var(--muted); font-size: 0.875rem;
        display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between;
      }
      footer .f-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
      footer a { color: var(--muted); text-decoration: none; }
      footer a:hover { color: var(--accent); }
      .eyebrow {
        font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.14em; color: var(--accent); margin-bottom: 0.75rem;
      }
      .muted { color: var(--muted); }
      .btn {
        display: inline-block; padding: 0.6rem 1.25rem; border-radius: 8px;
        font-weight: 600; font-size: 0.95rem; text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease;
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(232, 89, 12, 0.25); }
      .btn-ghost { border: 1px solid var(--border); color: var(--ink); background: transparent; }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
      .card {
        border: 1px solid var(--border); border-radius: 12px; padding: 1.4rem 1.5rem;
        margin-bottom: 1rem; background: var(--card);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26, 26, 26, 0.06); }
      .card h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
      .card p { color: var(--muted); font-size: 0.95rem; }
      .status {
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.5rem;
      }
      .chip {
        display: inline-block; background: var(--accent-soft); color: var(--accent-dark);
        border-radius: 999px; padding: 0.22rem 0.75rem; font-size: 0.83rem; font-weight: 500;
        margin: 0 0.4rem 0.4rem 0;
      }
      @media (max-width: 480px) {
        .container { padding: 1.5rem 1.1rem 2.5rem; }
        nav { gap: 0.3rem 1.1rem; margin-bottom: 2.5rem; }
        nav a.cta { margin-left: 0; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav>
        {
          links.map((l) => (
            <a href={l.href} class:list={[active === l.key && "active", l.key === "resume" && "cta"]}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <main>
        <slot />
      </main>
      <footer>
        <span>© {year} Chirag R Gandhi · Senior Product Manager · Luxembourg</span>
        <div class="f-links">
          <a href="mailto:chirag0912@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/chirag-gandhi" rel="noopener">LinkedIn</a>
          <a href="https://github.com/asp-builder-git" rel="noopener">GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>
