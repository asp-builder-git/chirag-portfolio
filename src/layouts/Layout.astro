---
import "../styles/fonts.css";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about" | "projects" | "resume";
}

const {
  title = "Chirag R Gandhi — Senior Technical Product Manager, Builder",
  active,
} = Astro.props;

const description =
  "Chirag R Gandhi — Senior Technical Product Manager and builder. Enterprise products at work, full-stack apps built with Claude, Cursor & OpenClaw. Projects, résumé.";

const links = [
  { href: "/chirag-portfolio/about", label: "About", key: "about" },
  { href: "/chirag-portfolio/projects", label: "Projects", key: "projects" },
  { href: "/chirag-portfolio/resume", label: "Resume", key: "resume" },
];

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={`${base}/fonts/instrument-serif-400.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/instrument-serif-400-italic.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/inter-400.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:global>
      :root {
        --bg: #fffdf8;
        --surface: #fffefb;
        --ink: #1a1a1a;
        --muted: #6b655c;
        --hairline: #e9e5da;
        --accent: #e8590c;
        /* accent as text (links, contact info) — ink-safe shade */
        --accent-text: #c2410c;
        /* legacy aliases so inner pages keep working */
        --card: var(--surface);
        --border: var(--hairline);
        --body: var(--ink);
        --accent-dark: var(--accent);
        --font-display: "Instrument Serif", "Instrument Serif Fallback", Georgia, serif;
        --font-body: "Inter", "Inter Fallback", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color-scheme: light;
      }
      :root[data-theme="dark"] {
        --bg: #16140f;
        --surface: #1c1913;
        --ink: #f2efe6;
        --muted: #9b948a;
        --hairline: #2a251d;
        --accent: #ff9d5c;
        --accent-text: #ff9d5c;
        color-scheme: dark;
      }
      /* No-JS fallback: follow the OS without a manual override */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          --bg: #16140f;
          --surface: #1c1913;
          --ink: #f2efe6;
          --muted: #9b948a;
          --hairline: #2a251d;
          --accent: #ff9d5c;
          --accent-text: #ff9d5c;
          color-scheme: dark;
        }
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      h1 {
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: -0.01em;
        line-height: 1.15;
        color: var(--ink);
      }
      h2 {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1.5rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      h3 {
        font-family: var(--font-body);
        font-weight: 600;
        line-height: 1.4;
        color: var(--ink);
      }
      ::selection { background: var(--accent); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      a {
        color: var(--ink);
        text-decoration: none;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }
      a:hover {
        text-decoration: underline;
        text-decoration-color: var(--accent);
      }
      /* Skip link — first focusable element, appears on focus only */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0.75rem;
        background: var(--bg);
        color: var(--ink);
        border: 1px solid var(--accent);
        border-radius: 6px;
        padding: 0.6rem 1rem;
        font-weight: 500;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0.75rem;
        text-decoration: none;
      }
      .container {
        max-width: 42rem;
        margin: 0 auto;
        padding: clamp(1.5rem, 5vw, 3rem);
      }
      nav {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.5rem;
        padding-bottom: 1rem; border-bottom: 1px solid var(--hairline); margin-bottom: 3rem;
      }
      nav a { font-size: 0.9375rem; font-weight: 500; padding: 0.15rem 0; }
      nav a.active {
        text-decoration: underline;
        text-decoration-color: var(--ink);
      }
      nav a.active:hover { text-decoration-color: var(--accent); }
      .theme-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 2.1rem; height: 2.1rem; border-radius: 999px;
        border: 1px solid var(--hairline); background: transparent; color: var(--muted);
        cursor: pointer; margin-left: auto; padding: 0;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .theme-toggle:hover { color: var(--ink); border-color: var(--ink); }
      .theme-toggle svg { width: 15px; height: 15px; display: block; }
      .theme-toggle .icon-sun { display: none; }
      [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
      [data-theme="dark"] .theme-toggle .icon-sun { display: block; }
      main { min-height: 50vh; }
      footer {
        margin-top: 5rem;
        color: var(--muted);
        font-size: 0.8125rem;
        display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
        align-items: baseline;
      }
      footer .f-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
      footer .f-group { display: inline-flex; align-items: baseline; gap: 0.5rem; }
      footer .f-cat {
        font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.08em; opacity: 0.75;
      }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--ink); }
      /* Tiny uppercase section labels */
      .label, .eyebrow {
        font-size: 0.8125rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted); line-height: 1;
      }
      .muted { color: var(--muted); }
      /* Buttons — two styles only */
      .btn {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 1rem; font-weight: 500; line-height: 1;
        border-radius: 6px;
        padding: 0.625rem 1.25rem;
        text-decoration: none;
        transition: opacity 0.15s ease, color 0.15s ease;
      }
      .btn:hover { text-decoration: none; }
      .btn-primary { background: var(--ink); color: var(--bg); }
      .btn-primary:hover { opacity: 0.85; }
      .btn-secondary { padding: 0; color: var(--ink); background: transparent; }
      .btn-secondary:hover { text-decoration: underline; text-decoration-color: var(--accent); color: var(--ink); }
      .btn-ghost { padding: 0; color: var(--ink); background: transparent; }
      .btn-ghost:hover { text-decoration: underline; text-decoration-color: var(--accent); }
      /* Quiet cards (inner pages only) */
      .card {
        border: 1px solid var(--hairline); border-radius: 10px; padding: 1.25rem 1.4rem;
        margin-bottom: 1rem; background: var(--surface);
      }
      .card h3 { font-size: 1.125rem; margin-bottom: 0.35rem; }
      .card h3 a { text-decoration: none; }
      .card h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
      .card p { color: var(--muted); font-size: 0.9375rem; }
      .status {
        font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted);
      }
      /* Smooth scroll only for users who want it; kill motion otherwise */
      @media (prefers-reduced-motion: no-preference) {
        html { scroll-behavior: smooth; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
      @media (max-width: 480px) {
        nav { gap: 0.35rem 1.15rem; margin-bottom: 2.5rem; }
        .theme-toggle { margin-left: auto; }
      }
    </style>
    <script is:inline>
      // Set theme before first paint: stored choice wins, else follow the OS.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        var dark =
          stored === "dark" ||
          (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <a class="skip-link" href="#main">Skip to content</a>
      <nav>
        {
          links.map((l) => (
            <a href={l.href} class:list={[active === l.key && "active"]}>
              {l.label}
            </a>
          ))
        }
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
      </nav>
      <main id="main">
        <slot />
      </main>
      <footer>
        <span>© {year} Chirag R Gandhi</span>
        <div class="f-links">
          <span class="f-group">
            <span class="f-cat">Professional</span>
            <a href="mailto:chirag0912@gmail.com">Email</a>
            <span>·</span>
            <a href="https://www.linkedin.com/in/chirag-gandhi" rel="noopener">LinkedIn</a>
          </span>
          <span class="f-group">
            <span class="f-cat">Personal</span>
            <a href="https://github.com/asp-builder-git" rel="noopener">GitHub</a>
          </span>
        </div>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
          var next = cur === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
