---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getProductionBaseSpec } from "../design/production-default";
import { applyAppearance, DEFAULT_APPEARANCE } from "../design/presets";
import { withBase } from "../lib/base";

const appearance = DEFAULT_APPEARANCE;
const spec = applyAppearance(getProductionBaseSpec(), appearance);
---
<SiteLayout
  spec={spec}
  appearance={appearance}
  title="Writing — Chirag Gandhi"
  active="home"
  showAppearance={false}
>
  <style>
    h1 { font-size: clamp(2rem, 5vw, 2.6rem); margin-bottom: 0.5rem; }
    .sub { color: var(--muted); margin-bottom: 2rem; max-width: 58ch; }
    .sub a { color: var(--ink); }
  </style>

  <div class="eyebrow">Writing</div>
  <h1>Writing</h1>
  <p class="sub">
    No posts here yet. When I publish, they land here — not a placeholder card.
    For now: <a href={withBase()}>home</a> and <a href={withBase("projects")}>projects</a>.
  </p>
</SiteLayout>
