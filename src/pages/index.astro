---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Chirag R Gandhi — Product Manager & Builder" active="home">
  <style>
    .hero h1 { font-size: clamp(2.6rem, 7vw, 3.8rem); margin: 0.25rem 0 0.5rem; }
    .hero .headline {
      font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
      font-size: 1.35rem; font-weight: 600; color: var(--ink);
      line-height: 1.35; margin-bottom: 0.9rem;
    }
    .hero .honest { font-size: 1.05rem; color: var(--muted); max-width: 60ch; margin-bottom: 1rem; }
    .section { margin-bottom: 3rem; }
    .section h2 {
      font-size: 1.35rem; margin-bottom: 1.1rem; padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .section .sub { color: var(--muted); font-size: 0.95rem; margin: -0.6rem 0 1.25rem; }
    .pro-summary { font-size: 1.05rem; max-width: 62ch; margin-bottom: 1.4rem; }
    .pro-summary p { margin-bottom: 0.6rem; }
    .pro-summary .skills-line { color: var(--ink); font-weight: 500; }
    .build-line { font-size: 0.95rem; color: var(--muted); margin-top: 0.9rem; }
    .more-link { margin-top: 0.25rem; display: inline-block; }
  </style>

  <section class="hero">
    <div class="eyebrow">Senior Product Manager · Luxembourg</div>
    <h1>Chirag R Gandhi</h1>
    <p class="headline">I enjoy solving real problems and adding value at scale.</p>
    <p class="honest">
      Eleven-plus years owning enterprise products — and I still build the tools myself.
    </p>
  </section>

  <section class="section">
    <h2>The professional side</h2>
    <div class="pro-summary">
      <p>
        <span class="skills-line">I own enterprise products end to end — strategy, discovery, delivery — and I build the tools myself: SQL, Python, React.</span>
      </p>
      <p>
        That's the 60-second proof. The full history — every role, number, and skill — is on the resume.
      </p>
    </div>
    <a class="btn btn-primary" href="/chirag-portfolio/resume">Full résumé →</a>
  </section>

  <section class="section">
    <h2>What I build myself</h2>
    <p class="sub">Personal projects — each published when it reaches a shareable state. No vaporware, no "coming soon".</p>
    <div class="card">
      <div class="status">Live</div>
      <h3>This portfolio site</h3>
      <p>Astro + GitHub Pages, built in public. The meta-project: proof I can finish things.</p>
    </div>
    <div class="card">
      <div class="status">In progress</div>
      <h3>Luxembourg Property Asymmetry Crawler</h3>
      <p>Compares broker listings against the atHome aggregator inventory to find what's listed where, and what's missing. Full pipeline: crawl → snapshot → match → dashboard.</p>
    </div>
    <div class="card">
      <div class="status">In progress</div>
      <h3>TrueReview</h3>
      <p>Honest restaurant ratings: analyzes Google reviews for suspicious patterns and shows the adjusted "true" rating.</p>
    </div>
    <div class="card">
      <div class="status">In progress</div>
      <h3>Market Evaluation — 4 Agents, 1 Day</h3>
      <p>A 4-week market study compressed into a single day using a 4-agent pipeline. Three ranked, ready-to-build business ideas.</p>
    </div>
    <p class="build-line">
      Everything on this site is real — each project published as it reaches a shareable state.
      A project counts when a stranger can open it.
    </p>
    <a class="btn btn-ghost more-link" href="/chirag-portfolio/projects">All projects →</a>
  </section>
</Layout>
