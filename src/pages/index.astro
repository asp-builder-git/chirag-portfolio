---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Chirag R Gandhi — Senior Technical Product Manager, Builder">
  <style>
    .intro h1 {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 1.7rem + 2.4vw, 3.25rem);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin: 0;
    }
    .intro .tagline {
      font-size: 1.125rem;
      font-weight: 500;
      color: var(--muted);
      line-height: 1.4;
      margin-top: 0.5rem;
    }
    .intro p.lead {
      font-size: 1.125rem;
      line-height: 1.7;
      max-width: 65ch;
      margin-top: 1rem;
      color: var(--ink);
    }
    .intro p.lead em {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      color: var(--ink);
    }
    .intro .cta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.5rem;
      margin-top: 1.5rem;
    }
    .intro { margin-bottom: 2.5rem; }
    .section + .section { margin-top: 3.5rem; }
    .section .label { display: block; margin-bottom: 1.25rem; }
    .row {
      border-top: 1px solid var(--hairline);
      padding: 1.25rem 0;
    }
    .row .row-title {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.4;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.3rem 0.75rem;
    }
    .row p {
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--muted);
      margin-top: 0.3rem;
      max-width: 60ch;
    }
    .section .more { margin-top: 1.25rem; }
    .build-line {
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--muted);
      margin-top: 1.25rem;
    }
  </style>

  <header class="intro">
    <h1>Chirag R Gandhi</h1>
    <p class="tagline">Senior Technical Product Manager, Builder</p>
    <p class="lead">
      I build enterprise products used by hundreds of internal Amazon users that support actions driving billion $ impact with engineering teams. I <em>build</em> full-stack apps with Claude in VS Code at work and with Cursor &amp; Openclaw at home.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/chirag-portfolio/resume">Professional Experience / Career</a>
      <a class="btn btn-secondary" href="/chirag-portfolio/projects">Projects →</a>
    </div>
  </header>

  <section class="section">
    <h2 class="label">Projects</h2>

    <div class="row">
      <div class="row-title">This portfolio site <span class="status">Live</span></div>
      <p>Astro + GitHub Pages, built in public. The meta-project: proof I can finish things.</p>
    </div>

    <div class="row">
      <div class="row-title">Luxembourg Property Asymmetry Crawler <span class="status">In progress</span></div>
      <p>Compares broker listings against the atHome aggregator inventory to find what's listed where, and what's missing.</p>
    </div>

    <div class="row">
      <div class="row-title">TrueReview <span class="status">In progress</span></div>
      <p>Honest restaurant ratings: analyzes Google reviews for suspicious patterns and shows the adjusted "true" rating.</p>
    </div>

    <div class="row">
      <div class="row-title">Market Evaluation — 4 Agents, 1 Day <span class="status">In progress</span></div>
      <p>A 4-week market study compressed into a single day using a 4-agent pipeline. Three ranked, ready-to-build business ideas.</p>
    </div>

    <p class="build-line">A project counts when a stranger can open it.</p>
    <a class="btn btn-secondary more" href="/chirag-portfolio/projects">All projects →</a>
  </section>

  <section class="section">
    <h2 class="label">Writing</h2>

    <div class="row">
      <div class="row-title">Why I'm publishing my work in public <span class="status">Coming soon</span></div>
      <p>The story behind this site, and the rule that runs it.</p>
    </div>

    <a class="btn btn-secondary more" href="/chirag-portfolio/writing">All writing →</a>
  </section>
</Layout>
