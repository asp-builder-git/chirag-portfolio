{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "scripts"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@design/*": ["src/design/*"],
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["src/data/*"],
      "@scripts/*": ["src/scripts/*"]
    }
  }
}
